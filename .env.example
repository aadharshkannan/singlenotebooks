AZURE_OPENAI_ENDPOINT="https://<your-openai-resource>.openai.azure.com/"
AZURE_OPENAI_API_VERSION="2024-02-01"
AZURE_OPENAI_DEPLOYMENT="gpt-5"
AZURE_OPENAI_EMBEDDING_DEPLOYMENT="text-embedding-3-small"
AZURE_SEARCH_ENDPOINT="https://<your-search-resource>.search.windows.net"
AZURE_SEARCH_INDEX="trace-clusters"

# FALSE keeps the original "search -> read -> edit" tool-signature embeddings.
# TRUE embeds one bounded canonical packet of the complete ordered session.
ENABLE_FULL_SESSION_EMBEDDINGS="FALSE"

# Full-session embedding profile. These are read only when full-session mode is
# enabled. Changing the model/version intentionally invalidates the local cache.
SESSION_EMBEDDING_MODEL_ID="capi-embedding"
SESSION_EMBEDDING_MODEL_VERSION="<immutable-model-version>"
SESSION_EMBEDDING_TOKENIZER_ID="text-embedding-3-small"
# Optional explicit tiktoken encoding for model aliases unknown to tiktoken.
# SESSION_EMBEDDING_TOKENIZER_ENCODING="cl100k_base"
SESSION_EMBEDDING_MAX_INPUT_TOKENS="8191"
# Bounded evidence packet shared by full-session embedding and live judging.
SESSION_REPRESENTATION_MAX_UTF8_BYTES="32768"
ESP_COSMOS_VECTOR_SPACE_ID="full-session-v1"
ESP_COSMOS_VECTOR_DIMENSIONS="1536"

# Optional: API key authentication (preferred over Entra ID if set)
# AZURE_OPENAI_API_KEY="your-api-key-here"

# Optional: Tenant ID for Entra ID authentication (to avoid tenant mismatch errors)
# AZURE_TENANT_ID="your-tenant-id-here"
